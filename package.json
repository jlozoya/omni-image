{
  "name": "omni-image",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:chrome": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "bun run build:chrome && bun run build:firefox",
    "build:chrome": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "bun run zip:chrome && bun run zip:firefox",
    "zip:chrome": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "playwright test"
  },
  "dependencies": {
    "@jsquash/avif": "2.1.1",
    "@jsquash/jxl": "1.3.0",
    "@jsquash/qoi": "latest",
    "@tesseract.js-data/eng": "1.0.0",
    "@tesseract.js-data/spa": "1.0.0",
    "fflate": "0.8.3",
    "gifenc": "1.0.3",
    "heic-to": "1.5.2",
    "react": "19.2.8",
    "react-aria-components": "1.20.0",
    "react-dom": "19.2.8",
    "tesseract.js": "7.0.0",
    "utif": "3.1.0"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@types/node": "22.20.2",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@wxt-dev/module-react": "1.2.2",
    "prettier": "^3.9.6",
    "typescript": "latest",
    "wxt": "0.21.4"
  }
}
